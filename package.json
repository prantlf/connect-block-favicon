{
  "name": "connect-block-favicon",
  "version": "2.0.0",
  "description": "Middleware for Connect or Express to silence browser requests for favicon.ico with no content.",
  "keywords": [
    "block",
    "connect",
    "express",
    "favicon",
    "favicon.ico",
    "middleware",
    "polka"
  ],
  "homepage": "https://github.com/prantlf/connect-block-favicon#readme",
  "bugs": {
    "url": "https://github.com/prantlf/connect-block-favicon/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ferdinand Prantl",
    "email": "prantlf@gmail.com",
    "url": "http://prantl.tk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prantlf/connect-block-favicon.git"
  },
  "files": [
    "index.js",
    "index.cjs"
  ],
  "type": "module",
  "main": "index.cjs",
  "module": "index.js",
  "exports": {
    ".": {
      "require": "./index.cjs",
      "import": "./index.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "oxlint",
    "fix": "npm run lint -- --fix",
    "format": "oxfmt",
    "check": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test": "npm run lint && npm run check"
  },
  "devDependencies": {
    "connect": "3.7.0",
    "express": "5.3.0",
    "jest": "30.5.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "polka": "0.5.2",
    "request": "2.88.2",
    "rollup": "4.65.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "roots": [
      "test"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/prantlf/connect-block-favicon/blob/master/LICENSE"
    }
  ]
}